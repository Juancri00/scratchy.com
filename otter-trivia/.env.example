# Copy to .env (or set in your host's dashboard). Values marked REQUIRED must be set in production.

# REQUIRED: password for /admin (12+ characters). Share only with the Otter booth team.
ADMIN_PASSWORD=
# REQUIRED (recommended): long random string that signs admin login cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# The live https:// address of the app. The booth QR code points here.
PUBLIC_URL=https://your-app.example.com
# Folder for the SQLite database. Must be on a PERSISTENT disk/volume in production.
DATA_DIR=./data
NODE_ENV=production
PORT=3000

# Event & raffle wording shown to players (all optional)
PRIZE_NAME=a $250 restaurant supply gift card
DRAW_INFO=One winner will be drawn at random at the Otter booth (#1234) on Sunday at 3:00 PM.
WINNER_CONTACT=We will call or text the winner at the phone number they entered. You do not need to be present to win.
# Minimum correct answers to enter the raffle. 0 = everyone who finishes gets one entry.
RAFFLE_MIN_SCORE=0
BOOTH_CTA=Stop by the Otter booth for a quick demo.
# Extra line added to the rules dialog, e.g. eligibility or a link to official rules.
RULES_EXTRA=Open to legal U.S. residents 18+ attending the event. Otter employees are not eligible. No purchase necessary.
